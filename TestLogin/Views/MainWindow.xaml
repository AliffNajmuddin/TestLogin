<Window x:Class="TestLogin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TestLogin - Revit Inspector"
        Height="600"
        Width="700"
        WindowStartupLocation="CenterScreen"
        MinHeight="500"
        MinWidth="600"
        Name="MainWindowControl"
        Icon="pack://application:,,,/TestLogin;component/Resources/Icons/mimarwhite.png">

    <Grid Name="MainGrid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15" Name="HeaderBorder">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- logo -->
                    <ColumnDefinition Width="*"/>    <!-- title -->
                    <ColumnDefinition Width="Auto"/> <!-- theme button -->
                    <ColumnDefinition Width="Auto"/> <!-- user info -->
                </Grid.ColumnDefinitions>

                <!-- Company logo -->
                <Image Grid.Column="0"
                       Source="pack://application:,,,/TestLogin;component/Resources/Icons/mimarwhite.png"
                       Width="60"
                       Height="32"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       ToolTip="Company Logo"/>

                <TextBlock Grid.Column="1"
                          Text="TestLogin - Revit Element Inspector"
                          Foreground="White" 
                          FontSize="16" 
                          FontWeight="Bold"
                          VerticalAlignment="Center"
                          Name="HeaderText"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button x:Name="ThemeToggleButton"
                            Content="🌙 Dark" 
                            Click="ThemeToggleButton_Click"
                            Width="80"
                            Height="25"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"
                            Margin="0,0,10,0"/>
                </StackPanel>

                <TextBlock Grid.Column="3"
                          x:Name="UserInfoText"
                          Text="Loading..."
                          Foreground="White"
                          FontSize="12"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Name="ContentGrid" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - User Info & Actions -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="Black">
                <StackPanel Margin="15" Name="LeftPanel">

                    <!-- Welcome Section -->
                    <GroupBox Header="Welcome" Margin="0,0,0,15"
                              Background="#F0F0F0"
                              Foreground="Black"
                              BorderBrush="#CCCCCC"
                              Name="WelcomeGroup">
                        <StackPanel>
                            <TextBlock x:Name="WelcomeText" 
                                      Text="Loading user information..."
                                      FontSize="14"
                                      TextWrapping="Wrap"
                                      Margin="10"
                                      Foreground="Black"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Quick Actions Section -->
                    <GroupBox Header="Quick Actions" Margin="0,0,0,15"
                              Background="#F0F0F0"
                              Foreground="Black"
                              BorderBrush="#CCCCCC"
                              Name="ActionsGroup">
                        <StackPanel>
                            <Button Content="Refresh User Data" 
                                    Click="RefreshData_Click" 
                                    Margin="10,5"
                                    Height="30"
                                    Background="#F0F0F0"
                                    Foreground="Black"/>
                            <Button Content="View Profile" 
                                    Click="ViewProfile_Click" 
                                    Margin="10,5"
                                    Height="30"
                                    Background="#F0F0F0"
                                    Foreground="Black"/>
                            <Button Content="Check All Elements" 
                                    Click="CheckAllElements_Click" 
                                    Margin="10,5"
                                    Height="30"
                                    Background="#F0F0F0"
                                    Foreground="Black"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Status Section -->
                    <GroupBox Header="Status &amp; Information"
                              Background="#F0F0F0"
                              Foreground="Black"
                              BorderBrush="#CCCCCC"
                              Name="StatusGroup">
                        <StackPanel>
                            <TextBlock x:Name="StatusText" 
                                      Text="Select elements in Revit to see their information here."
                                      TextWrapping="Wrap"
                                      Margin="10,5"
                                      Foreground="Black"/>
                            <ProgressBar x:Name="ActionProgress" 
                                        Height="10" 
                                        Margin="10,5" 
                                        Visibility="Collapsed"/>
                            <TextBlock x:Name="TokenInfoText"
                                      Text="Token information will appear here."
                                      FontSize="10"
                                      Foreground="Gray"
                                      TextWrapping="Wrap"
                                      Margin="10,5"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- Vertical Separator -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Right Panel - Revit Element Information -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="Black">
                <StackPanel Margin="15" Name="RightPanel">

                    <!-- Selection Info Header -->
                    <Border Background="#2D2D30" Padding="10" CornerRadius="3" Name="SelectionHeader">
                        <TextBlock Text="Revit Element Inspector" 
                                  Foreground="White" 
                                  FontSize="14" 
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Selection Stats -->
                    <GroupBox Header="Selection Stats" Margin="0,10,0,10"
                              Background="#F0F0F0"
                              Foreground="Black"
                              BorderBrush="#CCCCCC"
                              Name="StatsGroup">
                        <StackPanel>
                            <TextBlock x:Name="SelectionCountText" 
                                      Text="No elements selected"
                                      FontWeight="Bold"
                                      Margin="5,2"
                                      Foreground="Black"/>
                            <TextBlock x:Name="SelectionCategoriesText" 
                                      Text="Categories: None"
                                      FontSize="10"
                                      Margin="5,2"
                                      Foreground="Black"/>
                            <TextBlock x:Name="SelectionUpdateText" 
                                      Text="Last update: Never"
                                      FontSize="9"
                                      Margin="5,2"
                                      Foreground="Black"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Selected Elements List -->
                    <GroupBox Header="Selected Elements" Margin="0,0,0,10"
                              Background="#F0F0F0"
                              Foreground="Black"
                              BorderBrush="#CCCCCC"
                              Name="ElementsGroup">
                        <StackPanel>
                            <ListView x:Name="ElementsListView" 
                                     Height="200"
                                     Margin="5"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Background="White"
                                     Foreground="Black"
                                     BorderBrush="#CCCCCC"
                                     SelectionChanged="OnElementsListViewSelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ID" Width="60" DisplayMemberBinding="{Binding Id}"/>
                                        <GridViewColumn Header="Category" Width="120" DisplayMemberBinding="{Binding Category}"/>
                                        <GridViewColumn Header="Name" Width="100" DisplayMemberBinding="{Binding Name}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </GroupBox>

                    <!-- Element Details -->
                    <GroupBox Header="Element Details" Margin="0,0,0,10"
                              Background="#F0F0F0"
                              Foreground="Black"
                              BorderBrush="#CCCCCC"
                              Name="DetailsGroup">
                        <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ElementDetailsText" 
                                      Text="Select an element from the list to see details"
                                      TextWrapping="Wrap"
                                      Margin="5"
                                      Foreground="Black"/>
                        </ScrollViewer>
                    </GroupBox>

                    <!-- Quick Tools -->
                    <GroupBox Header="Quick Tools"
                              Background="#F0F0F0"
                              Foreground="Black"
                              BorderBrush="#CCCCCC"
                              Name="ToolsGroup">
                        <StackPanel>
                            <Button Content="Refresh Selection" 
                                    Click="RefreshSelection_Click" 
                                    Margin="5,2"
                                    Height="25"
                                    Background="#F0F0F0"
                                    Foreground="Black"/>
                            <Button Content="Clear Selection" 
                                    Click="ClearSelection_Click" 
                                    Margin="5,2"
                                    Height="25"
                                    Background="#F0F0F0"
                                    Foreground="Black"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="15" Name="FooterBorder">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="StayOnTopCheckBox"
                             Content="Keep window on top"
                             IsChecked="False"
                             Checked="StayOnTopCheckBox_Changed"
                             Unchecked="StayOnTopCheckBox_Changed"
                             Foreground="Gray"/>
                    <TextBlock x:Name="SelectionMonitorText" 
                              Text="Selection monitoring: Active" 
                              FontWeight="Bold"
                              Margin="20,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="Black"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hide" 
                            Click="Hide_Click" 
                            Margin="0,0,10,0"
                            Width="60"
                            Height="30"
                            Background="#F0F0F0"
                            Foreground="Black"
                            ToolTip="Hide window (use Revit Add-Ins tab to show again)"/>
                    <Button Content="Logout &amp; Close" 
                            Click="Logout_Click" 
                            Width="100"
                            Height="30"
                            Background="#F0F0F0"
                            Foreground="Black"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>